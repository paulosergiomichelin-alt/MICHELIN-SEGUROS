# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# OPENROUTER_API_KEY: Required for other models (Claude, etc) - MUST HAVE VITE_ PREFIX FOR FRONTEND ACCESS
VITE_OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# FIRESTORE_ECO_MODE: Set to true to reduce Firestore reads/writes (longer cache, less realtime)
VITE_FIRESTORE_ECO_MODE=false

# ─── POSTGRES (Neon) — migração gradual do Firestore ────────────────────────
# String de conexão do Neon (via Vercel Marketplace ou console.neon.tech).
# Mesma instância usada em dev local e produção — nunca hardcodar credenciais.
DATABASE_URL=

# Feature flag de corte controlado Firestore → Postgres (ver docs/db-migration/SPEC.md §9).
# false = usa Firestore (padrão, comportamento atual). true = usa a nova API Postgres.
USE_POSTGRES=false
VITE_USE_POSTGRES=false

# ─── EMAIL ENCRYPTION ────────────────────────────────────────────────────────
# Chave de criptografia de tokens/senhas de contas de e-mail (32 bytes).
# IMPORTANTE: se este ambiente NUNCA teve essa variável definida antes,
# use exatamente o valor abaixo no primeiro deploy — é o valor que o
# fallback hardcoded usava, e as contas Gmail/Microsoft já conectadas
# têm seus tokens criptografados com ele. Definir um valor diferente
# (ou deixar a variável ausente) quebra a decriptação de TODAS as
# contas já conectadas.
# Só troque para um valor novo depois de migrar (reencriptar) os
# tokens existentes com a nova chave — não faça isso neste deploy.
#
# ⚠ DÉBITO DE SEGURANÇA CONHECIDO E DELIBERADAMENTE POSTERGADO ⚠
# Este arquivo é versionado no git, então o valor abaixo é PÚBLICO — ele não é
# um segredo de verdade. Ele está aqui de propósito (decisão da Task 2 da Fase 1
# do projeto de e-mail) porque removê-lo quebraria a decriptação de todas as
# contas Gmail/Microsoft já conectadas, que foram criptografadas com o fallback
# hardcoded que tinha exatamente este valor.
# PENDÊNCIA: esta chave DEVE ser rotacionada para um segredo real (gerado por
# ambiente, fora do git) assim que existir uma migração de reencriptação que
# releia e regrave todos os `accessToken`/`refreshToken`/`passwordEncrypted` de
# `email_accounts` com a chave nova. Enquanto essa migração não existir, qualquer
# um com acesso ao repositório consegue decriptar senhas IMAP/SMTP e tokens OAuth
# armazenados. Isto está registrado como débito, NÃO esquecido.
EMAIL_ENCRYPTION_KEY=michelin-seguros-email-key-32chr

# ─── EMAIL OAUTH CREDENTIALS (Gmail/Microsoft) ───────────────────────────────
GMAIL_CALENDAR_REDIRECT_URI=
MICROSOFT_CALENDAR_REDIRECT_URI=

# ─── DEPLOY VPS (scripts/deploy-vps.mjs) ─────────────────────────────────────
# Nunca hardcodar credenciais no script — só aqui, em .env (gitignored).
VPS_HOST=143.95.211.30
VPS_PORT=22022
VPS_USER=root
VPS_PASS=YOUR_VPS_ROOT_PASSWORD

# ─── DATADOG (server-side — never expose in VITE_ vars) ─────────────────────
# Used by server.ts to proxy LLM Observability spans and by GitHub Actions
DD_API_KEY=YOUR_DD_API_KEY
DD_SITE=us5.datadoghq.com

# ─── DATADOG RUM + LOGS ───────────────────────────────────────────────────────
# Enable/disable Datadog observability (set true in .env.production only)
VITE_DD_ENABLED=false

# Datadog site: us5.datadoghq.com | datadoghq.com | eu1.datadoghq.com
VITE_DD_SITE=us5.datadoghq.com

# RUM Application ID and Client Token
# Datadog → UX Monitoring → RUM Applications → Create Application (React) → copy values
VITE_DD_RUM_APP_ID=YOUR_RUM_APP_ID
VITE_DD_RUM_CLIENT_TOKEN=YOUR_RUM_CLIENT_TOKEN

VITE_DD_SERVICE=michelin-crm-frontend
VITE_DD_ENV=production
# VITE_DD_VERSION is injected by CI (github.sha) — set manually for local testing
VITE_DD_VERSION=local
